# --- API ---
DATABASE_URL="postgresql://sportbuddy:sportbuddy@localhost:5432/sportbuddy?schema=public"
JWT_SECRET="dev-only-change-me"
PORT=4000

# --- Object storage (stubbed locally; swap for S3/GCS in production) ---
MEDIA_STORAGE_DRIVER="local"   # local | s3 | gcs
MEDIA_LOCAL_DIR="./uploads"

# --- Push notifications (stubbed; log-only until real creds are supplied) ---
PUSH_DRIVER="log"              # log | fcm | apns
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# --- Calendar sync (stubbed; log-only until OAuth apps are registered) ---
CALENDAR_DRIVER="log"          # log | google | apple
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- One-time sport photo download (apps/api/scripts/downloadSportImages.ts) ---
# Only needed to run that script once per sport; delete it once every active
# sport has a stored photo (Activity.iconUrl) — the app never calls Unsplash
# itself at runtime.
UNSPLASH_ACCESS_KEY=""

# --- Mobile app ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
