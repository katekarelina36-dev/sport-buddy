{
  "expo": {
    "name": "Sport Buddy",
    "slug": "sport-buddy",
    "scheme": "sportbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sportbuddy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sport Buddy uses your location to show nearby activity partners and communities.",
        "NSCalendarsUsageDescription": "Sport Buddy can add scheduled events to your calendar."
      }
    },
    "android": {
      "package": "com.sportbuddy.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "READ_CALENDAR", "WRITE_CALENDAR"]
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": { "origin": false }
    }
  }
}
